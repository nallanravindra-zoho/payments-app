# Copy to .env.local. Values come from `supabase status` (local) or Project Settings → API (hosted).
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=
# Demo affordances (sample hint text, "Explore owner demo"). Never enable in production.
VITE_DEMO_MODE=false
# mock | razorpay. With razorpay also set VITE_RAZORPAY_KEY_ID (publishable key id only; the secret lives in edge-function secrets).
VITE_PAYMENT_PROVIDER=mock
VITE_RAZORPAY_KEY_ID=
